<?xml version="1.0" encoding="utf-8"?>
<!--
  Nothing leaves the device through Android backup or device transfer: the API
  is the only destination (FR-PV-04), and the local store, preferences and
  secure storage stay where they are.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
